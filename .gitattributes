# The historical P/E datasets record the byte count and SHA-256 of their own
# data files, and the production loader derives input_set_id from the same
# bytes. A checkout that rewrites line endings would change those digests, so
# a digest recorded on one platform would not match the same commit checked
# out on another. Force LF for the dataset directory so the working tree, the
# git blob and every checkout platform agree byte for byte.
data/historical_pe/**/*.json text eol=lf

# The historical P/S and EV/EBITDA dataset is a tracked production input the
# same way, and its manifest pins the byte count and SHA-256 of its own files.
# The production loader derives input_set_id from the same bytes, so a checkout
# that rewrote line endings would change those digests.
data/historical_multiples/**/*.json text eol=lf

# The income-statement dataset is a tracked production input too, and its
# manifest pins the same way. The concept payloads are single-line responses
# with no newline to rewrite; the rule says so once rather than leaving it to
# be re-established.
data/historical_income/**/*.json text eol=lf

# The packaged filing facts are a tracked input the product reads, so their
# bytes are as much a part of the contract as the dataset files above: a
# checkout that rewrote them would change what the cross-currency analysis
# reads.
data/cross_currency/**/*.json text eol=lf

# The research capture pins its own files' SHA-256 in its manifest, and the
# research lane refuses to run against a capture whose bytes do not match
# that manifest. A checkout that rewrote the line endings would change the
# bytes the digest names, so the rule is the same as the dataset directories
# above.
data/research_multiples/**/*.json text eol=lf
data/research_lanes/**/*.json text eol=lf
